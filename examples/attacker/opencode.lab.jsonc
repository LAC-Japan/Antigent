// SPDX-License-Identifier: Apache-2.0
{
  "$schema": "https://opencode.ai/config.json",
  "model": "lab/default",

  // An independent OpenAI-compatible endpoint for the authorized lab attacker.
  // Configure the three LLM_* values through .env; no local secret is stored here.
  "provider": {
    "lab": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lab model endpoint",
      "options": {
        "baseURL": "{env:LLM_BASE_URL}",
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "default": {
          "id": "{env:LLM_MODEL_ID}",
          "name": "Lab model"
        }
      }
    }
  },

  "permission": {
    "bash": "allow",
    "edit": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
