# Attack Box settings. Copy to .env; keep it out of source control.
# The box joins only the internal network antigent-attack-lab. Attach each authorized
# target after `docker compose up`:
#   docker network connect antigent-attack-lab <target-container>

# Hosts egress-proxy may tunnel HTTPS to (comma list: host, .suffix or host:port).
# Default = OpenCode's built-in models; e.g. api.openai.com, llm.lab.internal:8001.
ATTACKER_EGRESS_ALLOW=opencode.ai
# Self-hosted endpoint whose name resolves to a private address.
# ATTACKER_EGRESS_ALLOW_PRIVATE=llm.lab.internal
# Corporate proxy to chain through.
# ATTACKER_EGRESS_UPSTREAM_PROXY=http://proxy.example.internal:8080

# Hosts or URLs authorized for testing. Blank = none; the agent stops and asks.
AUTHORIZED_TARGETS=

# Pinned build versions (upgrade deliberately).
OPENCODE_VERSION=2.3.0
GITLEAKS_VERSION=8.21.2
TRUFFLEHOG_VERSION=3.88.0

# OpenAI-compatible lab endpoint. Every command the agent runs can read these: use a
# dedicated low-limit key and add its host to ATTACKER_EGRESS_ALLOW.
# ATTACKER_OPENCODE_CONFIG=opencode.lab.jsonc
# ATTACKER_LLM_BASE_URL=https://llm.lab.invalid/v1
# ATTACKER_LLM_API_KEY=
# ATTACKER_LLM_MODEL_ID=

# CA bundle for TLS-inspecting proxies (see ca/README.md).
# Build time: directory containing combined-ca-bundle.pem.
# ATTACKER_CA_CONTEXT=../../ca
# Runtime: also uncomment the bundle's volume in docker-compose.yml.
# CA_BUNDLE_PATH=/etc/attackbox/ca/combined-ca-bundle.pem
