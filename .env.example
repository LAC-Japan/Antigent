# Antigent demo (`live_demo.py`) settings. Copy to .env and edit.
# Details: docs/usage.md (models, credentials), docs/configuration.md (addresses, ports).
# Use only on systems you are authorized to test.

# --- Target ------------------------------------------------------------------
# CI/CD Goat checkout (git clone https://github.com/cider-security-research/cicd-goat.git)
CICD_GOAT_DIR=./cicd-goat

# --- Models ------------------------------------------------------------------
# opencode/* free models need no key (`opencode models` lists them). Their prompts and
# tool output, lab secrets included, go to OpenCode's provider; check the data policy
# first: https://opencode.ai/docs/zen/#privacy
ATTACKER_MODEL=opencode/glm-5.3-flash-free
DEFENDER_MODEL=opencode/glm-5.3-flash-free

# openai/* models: set the key for each role that uses one.
#OPENAI_ATTACKER_KEY=
#OPENAI_DEFENDER_KEY=


# amazon-bedrock/* models (e.g. amazon-bedrock/global.moonshotai.kimi-k3).
# Defender: a bearer token or an access key pair.
#ANTIGENT_AWS_REGION=us-east-1
#ANTIGENT_AWS_BEARER_TOKEN_BEDROCK=
#ANTIGENT_AWS_ACCESS_KEY_ID=
#ANTIGENT_AWS_SECRET_ACCESS_KEY=
#ANTIGENT_AWS_SESSION_TOKEN=
# Attacker: its own credential, readable by every command it runs (prefer a short-lived
# token). Reusing the defender's needs ATTACKER_SHARE_DEFENDER_CREDENTIALS=1.
#ATTACKER_AWS_BEARER_TOKEN_BEDROCK=
#ATTACKER_AWS_ACCESS_KEY_ID=
#ATTACKER_AWS_SECRET_ACCESS_KEY=
#ATTACKER_AWS_SESSION_TOKEN=

# --- Attacker egress -----------------------------------------------------------
# The Attack Box reaches only its model's API host, through egress-proxy.
# Extra hosts (see refusals in runs/egress/egress.jsonl):
#ATTACKER_EGRESS_EXTRA_ALLOW=
# Corporate proxy to chain through (TLS inspection also needs ca/README.md):
#ATTACKER_EGRESS_UPSTREAM_PROXY=http://proxy.example.internal:8080

# --- Jenkins containment -------------------------------------------------------
# Needed only for jenkins_disable_job; without it Antigent can still plant decoys.
# The defense container is not on the lab's network: reach Jenkins through its published port.
#JENKINS_URL=http://host.docker.internal:8080
#JENKINS_ADMIN_USER=
# Quote a password that contains '#', e.g. JENKINS_ADMIN_PASSWORD='example#1'.
#JENKINS_ADMIN_PASSWORD=

# --- Timeouts (seconds) --------------------------------------------------------
ATTACK_STARTUP_TIMEOUT=300
ATTACK_TIMEOUT=1800
# Wait after the attack ends, for the defender's last turns.
DEFENSE_TURN_TIMEOUT=120

# --- Console -------------------------------------------------------------------
CONSOLE_PORT=8765
# Published on this machine only. To open it elsewhere, prefer an SSH tunnel; if you
# bind 0.0.0.0, list the name or IP used in the browser.
#CONSOLE_BIND=127.0.0.1
#CONSOLE_ALLOWED_HOSTS=

# --- Rarely needed -------------------------------------------------------------
# Run directory name under runs/.
DEMO_RUN_ID=demo
# Docker Desktop: if you browse the lab from the host, its address (often 192.168.65.1) to treat
# as internal. Antigent's own Jenkins requests are recognised automatically.
#ANTIGENT_HOST_ADDRESSES=
# Bridges the netsensor captures on (regex).
#NET_IFACES=^(docker0|br-.*)$
